{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "public": true,
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/*.js": {
      "memory": 512,
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/", "destination": "/public/index.html" },
    { "source": "/index.html", "destination": "/public/index.html" },
    { "source": "/styles.css", "destination": "/public/styles.css" },
    { "source": "/app.js", "destination": "/public/app.js" },
    { "source": "/typing.js", "destination": "/public/typing.js" },
    { "source": "/map.js", "destination": "/public/map.js" },
    { "source": "/icon.svg", "destination": "/public/icon.svg" },
    { "source": "/images/(.*)", "destination": "/public/images/$1" }
  ]
}
